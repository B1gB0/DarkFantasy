      _nameEn: Speed Potion
      _nameTr: "H\u0131z \u0130ksiri"
      _descriptionRu: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u0430 15 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
