      _nameEn: "\u0421astle"
      _nameTr: Kilit
    ItemsData:
    - _id: healthPotion
      _type: 1
      _value: 70
      _price: 30
      _duration: 1
      _isMultiplier: 0
      _nameRu: "\u0417\u0435\u043B\u044C\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
      _nameEn: Health Potion
      _nameTr: "Sa\u011Fl\u0131k iksiri"
      _descriptionRu: "\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
        70 \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
      _descriptionEn: Instantly restores 70 health points
      _descriptionTr: "An\u0131nda 70 sa\u011Fl\u0131k birimini yeniler"
    - _id: speedPotion
      _type: 2
      _value: 5
      _price: 20
      _duration: 30
      _isMultiplier: 1
      _nameRu: "\u0417\u0435\u043B\u044C\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
      _nameEn: Speed Potion
      _nameTr: "H\u0131z iksiri"
      _descriptionRu: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u0430 5 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
        30 \u0441\u0435\u043A\u0443\u043D\u0434"
      _descriptionEn: Increases speed by 5 percent for a duration of 30 seconds
      _descriptionTr: "H\u0131z\u0131 30 saniye boyunca y\xFCzde 5 oran\u0131nda
        art\u0131r\u0131r"
    - _id: meat
      _type: 3
      _value: 5
      _price: 10
      _duration: 5
      _isMultiplier: 1
      _nameRu: "\u041C\u044F\u0441\u043E"
      _nameEn: Meat
      _nameTr: Et
      _descriptionRu: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
        5 \u043E\u0447\u043A\u043E\u0432 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
        \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
        5 \u0441\u0435\u043A\u0443\u043D\u0434"
      _descriptionEn: Restores 5 health points per second for a duration of 5 seconds
      _descriptionTr: "Saniyede 5 can puan\u0131 geri kazand\u0131r\u0131r, s\xFCre
        5 saniyedir"
