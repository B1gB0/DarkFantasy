    CharacteristicsLocalizationData:
    - _type: 0
      _nameRu: "\u0423\u0440\u043E\u043D"
      _nameEn: Damage
      _nameTr: Hasar
      _descriptionRu: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u0443\u0440\u043E\u043D"
      _descriptionEn: Increase damage
      _descriptionTr: "Hasar\u0131 art\u0131rmak"
    - _type: 1
      _nameRu: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
      _nameEn: Health
      _nameTr: "Sa\u011Fl\u0131k"
      _descriptionRu: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
      _descriptionEn: Increase the maximum amount of health
      _descriptionTr: "Maksimum sa\u011Fl\u0131k miktar\u0131n\u0131 art\u0131rmak"
    - _type: 2
      _nameRu: "\u0411\u0440\u043E\u043D\u044F"
      _nameEn: Armor
      _nameTr: "Z\u0131rh"
      _descriptionRu: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0431\u0440\u043E\u043D\u0438"
      _descriptionEn: Increase the amount of armor
      _descriptionTr: "Z\u0131rh miktar\u0131n\u0131 art\u0131r\u0131n"
